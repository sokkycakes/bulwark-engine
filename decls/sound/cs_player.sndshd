// Player and zombie sounds. File names are OBSERVED in the build's
// sound/player and sound/zombi; which event uses which file is STOCK-CS
// for humans and INFERRED from the names for zombies.

Player.Jump
{
	sample player/pl_jump1.wav
	sample player/pl_jump2.wav
}

Player.Death
{
	sample player/die1.wav
	sample player/die2.wav
	sample player/die3.wav
}

Player.Pain
{
	sample player/bhit_flesh-1.wav
	sample player/bhit_flesh-2.wav
	sample player/bhit_flesh-3.wav
}

Player.Headshot
{
	sample player/headshot1.wav
	sample player/headshot2.wav
	sample player/headshot3.wav
}

Player.PickupWeapon
{
	sample items/gunpickup2.wav
}

Zombie.Death
{
	sample zombi/zombi_death_1.wav
	sample zombi/zombi_death_2.wav
}

Zombie.Pain
{
	sample zombi/zombi_hurt_01.wav
	sample zombi/zombi_hurt_02.wav
}

Zombie.Swing
{
	sample zombi/zombi_swing_1.wav
	sample zombi/zombi_swing_2.wav
	sample zombi/zombi_swing_3.wav
}

Zombie.Hit
{
	sample zombi/zombi_attack_1.wav
	sample zombi/zombi_attack_2.wav
	sample zombi/zombi_attack_3.wav
}

Zombie.HitWall
{
	sample zombi/zombi_wall_1.wav
	sample zombi/zombi_wall_2.wav
	sample zombi/zombi_wall_3.wav
}

Zombie.Infect
{
	sample zombi/human_death_01.wav
	sample zombi/human_death_02.wav
}
