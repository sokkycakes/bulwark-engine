// ==========================================================================
// CSNZ Character / Buff Class System
// ==========================================================================
//
// Reverse-engineered from buffclass strings found in mp.dll binary data.
// CSNZ assigns each playable character a buff class that modifies base
// player stats (health, armor, movement speed, etc.). Characters inherit
// from base player classes (csm_rifleman for combat roles, csm_basic for
// specialist/utility roles) and override specific attributes.
//
// Factions:  CT = Counter-Terrorist,  T = Terrorist
//
// All values are DESIGN APPROXIMATIONS derived from observed gameplay
// behavior and binary constant analysis. Actual server values may differ
// due to region-specific tuning or patch changes.
//
// Speed reference:  default pm_runspeed = 250, pm_walkspeed ~ runspeed * 0.52
// ==========================================================================

// --------------------------------------------------------------------------
// 1. Fernando  -  CT, balanced rifleman
// --------------------------------------------------------------------------
entityDef csm_char_fernando
{
	"inherit"		"csm_rifleman"
	"netname"		"Fernando"
	"health"		"100"
	"max_health"		"100"
	"armor"			"0"
	"maxarmor"		"100"
	"pm_walkspeed"		"130"
	"pm_runspeed"		"250"
}

