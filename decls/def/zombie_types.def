// ============================================================================
// VARIANT CLAW WEAPONS
// ============================================================================
// These override the base weapon_csnz_claw (defined in zombi.def) for zombie
// types that need different attack properties. All damage/rate values are
// DESIGN approximations.

// --- Fast Claw: higher attack speed, lower damage per hit ---
// Used by: Psycho, Stingfinger, Chaser
entityDef weapon_csnz_claw_fast
{
	"inherit"		"weapon_csnz_claw"
	"inv_name"		"Fast Claw"
	// DESIGN: 0.35s fire rate (vs 0.6s base) - rapid slashing
	"fireRate"		"0.35"
	"failRate"		"0.35"
	"def_onFire"		"projectile_csnz_claw_fast"
}

entityDef projectile_csnz_claw_fast
{
	"spawnclass"		"ncProjectile"
	"is_bullet"		"1"
	// DESIGN: 14 damage per hit (vs 20 base) - compensated by attack speed
	"damage"		"14"
	"range"			"64"
	"weapon"		"weapon_csnz_claw_fast"
	"decal_detonate"	"Impact.Shot"
	"snd_hitBody"		"Zombie.Hit"
	"snd_hitWorld"		"Zombie.HitWall"
}

// --- Heavy Claw: slower but harder hitting ---
// Used by: Heavy, Stamper
entityDef weapon_csnz_claw_heavy
{
	"inherit"		"weapon_csnz_claw"
	"inv_name"		"Heavy Claw"
	// DESIGN: 0.9s fire rate (vs 0.6s base) - slow but devastating
	"fireRate"		"0.9"
	"failRate"		"0.9"
	"def_onFire"		"projectile_csnz_claw_heavy"
}

entityDef projectile_csnz_claw_heavy
{
	"spawnclass"		"ncProjectile"
	"is_bullet"		"1"
	// DESIGN: 35 damage per hit (vs 20 base) - power strikes
	"damage"		"35"
	"range"			"72"
	"weapon"		"weapon_csnz_claw_heavy"
	"decal_detonate"	"Impact.Shot"
	"snd_hitBody"		"Zombie.Hit"
	"snd_hitWorld"		"Zombie.HitWall"
}

// --- Giant Claw: boss-tier weapon for Metatron ---
// Used by: Metatron
entityDef weapon_csnz_claw_giant
{
	"inherit"		"weapon_csnz_claw"
	"inv_name"		"Giant Claw"
	// DESIGN: 1.2s fire rate - massive windup, devastating impact
	"fireRate"		"1.2"
	"failRate"		"1.2"
	"testDistance"		"-80"
	"def_onFire"		"projectile_csnz_claw_giant"
}

entityDef projectile_csnz_claw_giant
{
	"spawnclass"		"ncProjectile"
	"is_bullet"		"1"
	// DESIGN: 60 damage per hit - boss-tier devastation
	"damage"		"60"
	// DESIGN: 80 range (vs 64 base) - massive reach
	"range"			"80"
	"weapon"		"weapon_csnz_claw_giant"
