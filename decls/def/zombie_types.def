// CSNZ Zombie Host Types - entityDef declarations
//
// All 18 zombie host types identified from binary evidence.
// Inherits from player_csnz_zombie (defined in zombi.def).
//
// Evidence: DESIGN - all stat values are approximated from binary patterns
// and behavioral observation; they are NOT exact CSNZ values.
// Tune as needed for gameplay balance.

// ============================================================================
// Type 0: NORMAL - base zombie (already defined as player_csnz_zombie in
// zombi.def; this alias exists for completeness in the type enum)
// ============================================================================
entityDef csm_zombie_normal
{
	"inherit"		"player_csnz_zombie"
	// DESIGN: 1000 HP, 280 speed (matches base player_csnz_zombie)
	"health"		"1000"
	"max_health"		"1000"
	"pm_walkspeed"		"280"
	"pm_runspeed"		"280"
}

