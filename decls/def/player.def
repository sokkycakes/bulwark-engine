entityDef player_t_arctic		{ "inherit" "player" "model" "models/player/arctic/arctic.mdl" }
entityDef player_t_guerilla		{ "inherit" "player" "model" "models/player/guerilla/guerilla.mdl" }
entityDef player_t_leet			{ "inherit" "player" "model" "models/player/leet/leet.mdl" }
entityDef player_t_terror		{ "inherit" "player" "model" "models/player/terror/terror.mdl" }

// Zombie: zombi_origin.mdl (Zombi's host zombie) has its own sequence order
// after 72 (OBSERVED): 73 crouch_aim_knife, 75 ref_aim_knife, 76-79 knife
// idle/walk/run/jump, 80 ref_shoot_knife, 107-109 death1-3.
entityDef player_zombie
{
	"inherit"			"player"
	"model"				"models/player/zombi_origin/zombi_origin.mdl"
	"weapon"			"weapon_csnz_claw"
	"current_weapon"	"0"
	"act_idle"			"76"
	"act_walk"			"77"
	"act_run"			"78"
	"act_jump"			"79"
	"act_death"			"107,108,109"
	"act_dieHeadshot"	"110"
	"act_smallFlinch"	"104"
	"act_bigFlinch"		"105"
	"act_aim_knife"				"75"
	"act_attack_knife"			"80,81"
	"act_aim_crouch_knife"		"73"
	"act_attack_crouch_knife"	"74"
}

entityDef player_zombie_host
{
	"inherit"			"player_zombie"
	"model"				"models/player/zombi_host/zombi_host.mdl"
}
