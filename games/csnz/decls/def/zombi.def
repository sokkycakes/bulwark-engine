// Zombi (mode 8) entity definitions.
//
// Evidence levels (see evidence/ZOMBI-CLIENT-EVIDENCE.md):
//   OBSERVED (Z3): zombies have higher HP and faster speeds than humans;
//     attacked zombies are pushed back and momentarily stunned.
//   Every number below is a TEMPORARY APPROXIMATION chosen for this mod,
//   not CSNZ data. Models, view models and sounds are the build's own
//   (OBSERVED files, see player.def and cs_weapons.def); the loadout is DESIGN.

// --- humans: knife, pistol and rifle (DESIGN loadout, CS weapons) ---
entityDef player_csnz_human
{
	"inherit"			"player"
	"weapon"			"weapon_knife,weapon_usp,weapon_m4a1"
	"current_weapon"	"2"
	"ammo_45acp"		"100"
	"ammo_556nato"		"90"
	"pm_walkspeed"		"250"
	"pm_runspeed"		"250"
}

// --- zombies: claw only, faster than humans ---
