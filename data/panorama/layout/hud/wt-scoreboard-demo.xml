<!--
	DEMO copy of wt-scoreboard.xml: same panel over a sky-blue backdrop (like
	the reference screenshot), with WtScore.Demo() ticking the clock and
	trading points. Open with `exec panorama/wt-scoreboard.cfg`. Keep the
	panels in step with wt-scoreboard.xml.
-->
<!--
	Team match header in the WolfTeam style (sokky's reference screenshot,
	2026-11-02): a steel frame at the top centre with a team emblem tile at
	each side, the mode name and points goal on a glass bar, the two team
	scores with a lead arrow in a dark well, the round timer under it, and
	the local player's kills/deaths at the left edge with a watched player's
	name and kills/deaths at the right edge.

	Laid out at 800x600 (bwdesignheight="600"), the size the reference was
	taken at; it scales with the screen like any Panorama view.

	Reusable: a HUD progs opens it embedded (ui_open flag 2), draws it
	with ui_draw and posts JSON to it: ui_post(view, "state",
	"{\"red\":28,\"blue\":26}"). See scripts/hud/wt-scoreboard.js for the
	fields. `exec panorama/wt-scoreboard.cfg` shows the demo layout.
-->
<root>
	<styles>
		<include src="file://{resources}/styles/hud/wt-scoreboard.css" />
	</styles>
	<scripts>
		<include src="file://{resources}/scripts/hud/wt-scoreboard.js" />
	</scripts>
	<Panel id="WtScreen" class="WtDemo" bwdesignheight="600" hittest="false">
		<Panel id="WtBoard">
			<Panel id="WtTileRed" class="WtTile Red">
				<Panel class="WtEmblem" />
			</Panel>
			<Panel id="WtHeader">
				<Panel id="WtHeaderRow">
					<Label id="WtMode" text="Deathmatch" />
					<Label id="WtGoal" text="160" />
					<Label id="WtGoalUnit" text="Points" />
				</Panel>
			</Panel>
			<Panel id="WtWell">
				<Label id="WtRed" class="WtScoreNum" text="28" />
				<Panel id="WtLead" class="LeadRed" />
				<Label id="WtBlue" class="WtScoreNum" text="26" />
			</Panel>
			<Panel id="WtTileBlue" class="WtTile Blue">
				<Panel class="WtEmblem" />
			</Panel>
		</Panel>
		<Panel id="WtTimer">
			<Label id="WtMin" class="WtTimeNum" text="35" />
			<Label id="WtColon" class="WtTimeNum" text=":" />
			<Label id="WtSec" class="WtTimeNum" text="52" />
		</Panel>
		<Panel id="WtSelf" class="WtKd">
			<Label class="WtKills" id="WtSelfKills" text="4" />
			<Label class="WtDeaths" id="WtSelfDeaths" text="/8" />
		</Panel>
		<Panel id="WtWatch">
			<Label id="WtWatchName" text="VIPCaslese" />
			<Panel class="WtKd">
				<Label class="WtKills" id="WtWatchKills" text="12" />
				<Label class="WtDeaths" id="WtWatchDeaths" text="/4" />
			</Panel>
		</Panel>
	</Panel>
</root>
