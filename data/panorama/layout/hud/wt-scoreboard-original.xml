<!--
	Team match header with WolfTeam's own art (sokky's go-ahead, 2026-11-02).
	Same fields and script as wt-scoreboard.xml, but drawn from WolfTeam's
	textures in images/hud/wt-private/ (private, never in git; see
	styles/hud/wt-scoreboard-original.css). Laid out at 384 lines, the scale
	WolfTeam's UI script uses. `exec panorama/wt-scoreboard-original.cfg`
	opens the demo copy (class WtDemo: sky backdrop, running clock).
-->
<root>
	<styles>
		<include src="file://{resources}/styles/hud/wt-scoreboard-original.css" />
	</styles>
	<scripts>
		<include src="file://{resources}/scripts/hud/wt-scoreboard.js" />
	</scripts>
	<Panel id="WtoScreen" class="WtDemo" bwdesignheight="384" hittest="false">
		<Panel id="WtoBoard">
			<Panel id="WtoTileRed" class="WtoTile" />
			<Label id="WtoMode" text="Deathmatch" />
			<Panel id="WtoGoalBox"><Panel id="WtoGoal" class="WtoNum N2 Right" /></Panel>
			<Panel id="WtoPoints" />
			<Panel id="WtoRedBox"><Panel id="WtoRed" class="WtoNum N1 Right" /></Panel>
			<Panel id="WtoSign" />
			<Panel id="WtoBlueBox"><Panel id="WtoBlue" class="WtoNum N1" /></Panel>
			<Panel id="WtoTileBlue" class="WtoTile" />
		</Panel>
		<Panel id="WtoTimer">
			<Panel id="WtoMinBox"><Panel id="WtoMin" class="WtoNum N1 Right" /></Panel>
			<Label id="WtoColon" text=":" />
			<Panel id="WtoSecBox"><Panel id="WtoSec" class="WtoNum N1" /></Panel>
		</Panel>
		<Panel id="WtoSelf" class="WtoKd">
			<Panel id="WtoSelfKills" class="WtoNum N4" />
			<Label class="WtoSlash" text="/" />
			<Panel id="WtoSelfDeaths" class="WtoNum N5" />
		</Panel>
		<Panel id="WtoWatch">
			<Label id="WtoWatchName" text="VIPCaslese" />
			<Panel class="WtoKd">
				<Panel id="WtoWatchKills" class="WtoNum N4" />
				<Label class="WtoSlash" text="/" />
				<Panel id="WtoWatchDeaths" class="WtoNum N5" />
			</Panel>
		</Panel>
	</Panel>
</root>
