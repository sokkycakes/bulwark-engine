<!--
	Panorama port of Stiletto's data/web/hud/index.html: the in-game HUD the
	client game creates as the gecko view "webcore_hud" and draws into its 4:3
	HUD rectangle. The original paints a <canvas> every frame; here the same
	pieces are images from the page's own asset pack (assets-data.js) and
	labels, updated from hud.js.
	It takes no input.
-->
<root>
	<styles>
		<include src="file://{resources}/styles/web/hud.css" />
	</styles>
	<scripts>
		<include src="file://{game}/data/web/hud/assets-data.js" />
		<include src="file://{resources}/scripts/web/hud.js" />
	</scripts>
	<Panel id="Hud" class="hud hp-normal" hittest="false">
		<Panel id="Stage" class="stage">
			<Image class="ring" data-asset="hudring" scaling="stretch" />
			<Label id="Speed" class="speed f-iosevka" text="000" />

			<Image class="time-plate" data-asset="timeIndicator" scaling="stretch" />
			<Label id="Timer" class="timer f-trade" text="00:00" />
			<Label id="ScoreLeft" class="score f-helv score-left" text="0" />
			<Label id="ScoreRight" class="score f-helv score-right" text="0" />
			<Panel class="nameplate nameplate-left">
				<Label id="NameLeft" class="name f-trade" text="P1" />
			</Panel>
			<Panel class="nameplate nameplate-right">
				<Label id="NameRight" class="name f-trade" text="P2" />
			</Panel>
			<Image class="mini-pip mini-pip-0" data-asset="abilityPip" scaling="stretch" />
			<Image class="mini-pip mini-pip-1" data-asset="abilityPip" scaling="stretch" />
			<Image class="mini-pip mini-pip-2" data-asset="abilityPip" scaling="stretch" />

			<Panel id="HpBox" class="hp">
				<Image class="hp-full" data-asset="hpFull" scaling="stretch" />
				<Image class="hp-low-img" data-asset="hpLow" scaling="stretch" />
				<Image class="hp-dead-img" data-asset="hpDead" scaling="stretch" />
			</Panel>
			<Label id="Clip" class="clip f-pixel" text="0|" />
			<Label id="Reserve" class="reserve f-pixel" text="0" />
			<Label id="Reload" class="reload f-iosevka" text="0.0" />
			<Image id="Pip0" class="pip pip-0" data-asset="abilityPip" scaling="stretch" />
			<Image id="Pip1" class="pip pip-1" data-asset="abilityPip" scaling="stretch" />
			<Image id="Pip2" class="pip pip-2" data-asset="abilityPip" scaling="stretch" />

			<Panel id="Cooldown0" class="cooldown cooldown-0">
				<Image class="cd-icon" data-asset="circlesExt1" scaling="stretch" />
				<Panel class="cd-ring" />
			</Panel>
			<Panel id="Cooldown1" class="cooldown cooldown-1">
				<Image class="cd-icon" data-asset="deployedCode" scaling="stretch" />
				<Panel class="cd-ring" />
			</Panel>
			<Panel id="Cooldown2" class="cooldown cooldown-2">
				<Image class="cd-icon" data-asset="deblur" scaling="stretch" />
				<Panel class="cd-ring" />
			</Panel>
			<Label id="CdTime0" class="cd-time f-helv cd-time-0" text="" />
			<Label id="CdTime1" class="cd-time f-helv cd-time-1" text="" />
			<Label id="CdTime2" class="cd-time f-helv cd-time-2" text="" />
		</Panel>

		<Panel id="Left" class="left">
			<Image class="ex-plate" data-asset="exIndicator" scaling="stretch" />
			<Image class="gauge" data-asset="union" scaling="stretch" />
			<Label id="ExCount" class="ex-count f-helv-ob" text="0" />
			<Label class="ex-max f-helv-ob" text="MAX" />
		</Panel>
	</Panel>
</root>
