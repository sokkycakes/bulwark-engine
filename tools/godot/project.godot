; A starter Godot project for editing Bulwark scenes. Copy it next to your
; game's content, or copy addons/bulwark into an existing project (such as
; Nuclide's worldsrc) and enable it under Project Settings > Plugins.

config_version=5

[application]

config/name="Bulwark Editor"
config/features=PackedStringArray("4.5", "GL Compatibility")

[bulwark]

game_directory="res://"
units_per_meter=32.0

[editor_plugins]

enabled=PackedStringArray("res://addons/bulwark/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.07, 0.09, 0.13, 1)
