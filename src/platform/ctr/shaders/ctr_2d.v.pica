; Bulwark engine - PICA200 vertex shader for the 2D and unlit programs.
; ISC licence, see LICENSE.
;   clip = mvp * pos            (mvp already carries the screen tilt)
;   tc   = tc * tcmod.zw + tcmod.xy
;   col  = vertex colour / 255 * colmul + coladd
.fvec mvp[4]
.fvec tcmod
.fvec colmul
.fvec coladd

.constf k(0.0, 1.0, 0.003921568627, 0.5)

.out opos position
.out otc texcoord0
.out oclr color

.alias apos v0
.alias atc v1
.alias acol v4

.entry main_2d
.proc main_2d
	mov r0.xyz, apos
	mov r0.w, k.yyyy
	dp4 opos.x, mvp[0], r0
	dp4 opos.y, mvp[1], r0
	dp4 opos.z, mvp[2], r0
	dp4 opos.w, mvp[3], r0

	mov r1, atc
	mul r1.xy, tcmod.zwzw, r1.xyxy
	add otc.xy, tcmod.xyxy, r1.xyxy

	mul r2, k.zzzz, acol
	mul r2, colmul, r2
	add oclr, coladd, r2
	end
.end
