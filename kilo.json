{
  "$schema": "https://kilo.ai/config.json",
  "mcp": {
    "ghidra": {
      "type": "local",
      "command": [
        "/opt/ghidra-mcp/bin/pyghidra-mcp",
        "--transport", "stdio",
        "--project-path", "/workspace/ghidra_projects"
      ],
      "environment": {
        "GHIDRA_INSTALL_DIR": "/opt/ghidra"
      },
      "enabled": true,
      "timeout": 600000
    }
  }
}
