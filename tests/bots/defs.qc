/* Minimal server game definitions for the bot tests: the system globals and
 * fields the engine fills in, and the builtins the bot framework and the
 * tests call (matched by name). ISC licence, see LICENSE. */
#pragma target fte

entity self, other, world;
float time, frametime, force_retouch;
string mapname;
float deathmatch, coop, teamplay, serverflags, total_secrets, total_monsters, found_secrets, killed_monsters;
float parm1, parm2, parm3, parm4, parm5, parm6, parm7, parm8, parm9, parm10, parm11, parm12, parm13, parm14, parm15, parm16;
vector v_forward, v_up, v_right;
float trace_allsolid, trace_startsolid, trace_fraction;
vector trace_endpos, trace_plane_normal;
float trace_plane_dist;
entity trace_ent;
float trace_inopen, trace_inwater;
entity msg_entity;
void main(void);
void StartFrame(void);
void PlayerPreThink(void);
void PlayerPostThink(void);
void ClientKill(void);
void ClientConnect(void);
void PutClientInServer(void);
void ClientDisconnect(void);
void SetNewParms(void);
void SetChangeParms(void);
void end_sys_globals;

.float modelindex;
.vector absmin, absmax;
.float ltime, movetype, solid;
.vector origin, oldorigin, velocity, angles, avelocity, punchangle;
.string classname, model;
.float frame, skin, effects;
.vector mins, maxs, size;
.void() touch, use, think, blocked;
.float nextthink;
.entity groundentity;
.float health, frags, weapon;
.string weaponmodel;
.float weaponframe, currentammo, ammo_shells, ammo_nails, ammo_rockets, ammo_cells, items, takedamage;
.entity chain;
.float deadflag;
.vector view_ofs;
.float button0, button1, button2, impulse, fixangle;
.vector v_angle;
.float idealpitch;
.string netname;
.entity enemy;
.float flags, colormap, team, max_health, teleport_time, armortype, armorvalue, waterlevel, watertype, ideal_yaw, yaw_speed;
.entity aiment, goalentity;
.float spawnflags;
.string target, targetname;
.float dmg_take, dmg_save;
.entity dmg_inflictor, owner;
.vector movedir;
.string message;
.float sounds;
.string noise, noise1, noise2, noise3;
void end_sys_fields;

.void() customphysics;
.int hitcontentsmaski;
.float frame1time;

const float FALSE = 0;
const float TRUE = 1;
const float M_PI = 3.14159265358979;
const float MOVETYPE_NONE = 0;
const float MOVETYPE_WALK = 3;
const float SOLID_NOT = 0;
const float SOLID_TRIGGER = 1;
const float SOLID_SLIDEBOX = 3;
const float SOLID_BSP = 4;
const float DAMAGE_NO = 0;
const float DAMAGE_AIM = 2;
const float FL_CLIENT = 8;
const float FL_MONSTER = 32;
const float FL_ONGROUND = 512;
const float MOVE_NORMAL = 0;
const float MOVE_NOMONSTERS = 1;
const float FILE_READ = 0;
const int CONTENTBIT_SOLID = 0x00000001i;
const int CONTENTBIT_PLAYERCLIP = 0x00010000i;
const int CONTENTBIT_MONSTERCLIP = 0x00020000i;
typedef float filestream;

void(vector ang) makevectors = #0:makevectors;
void(entity e, vector o) setorigin = #0:setorigin;
void(entity e, vector mn, vector mx) setsize = #0:setsize;
float() random = #0:random;
vector(vector v) normalize = #0:normalize;
float(vector v) vlen = #0:vlen;
float(vector v) vectoyaw = #0:vectoyaw;
vector(vector v) vectoangles = #0:vectoangles;
void(string s, ...) error = #0:error;
void(vector a, vector b, float nomonsters, entity ignore) traceline = #0:traceline;
void(vector a, vector mn, vector mx, vector b, float nomonsters, entity ignore) tracebox = #0:tracebox;
float(vector view, entity e) checkpvs = #0:checkpvs;
entity() spawn = #0:spawn;
void(entity e) remove = #0:remove;
float(entity e) wasfreed = #0:wasfreed;
float(string s) cvar = #0:cvar;
string(string s) cvar_string = #0:cvar_string;
void(string name, string value) cvar_set = #0:cvar_set;
float(string name, string value, optional float flags) registercvar = #0:registercvar;
void(string s, ...) print = #0:print;
void(string s, ...) localcmd = #0:localcmd;
string(float f) ftos = #0:ftos;
string(vector v) vtos = #0:vtos;
string(entity e) etos = #0:etos;
float(string s) stof = #0:stof;
float(float f) fabs = #0:fabs;
float(float f) floor = #0:floor;
float(float f) sqrt = #0:sqrt;
float(float f) sin = #0:sin;
float(float f) cos = #0:cos;
float(float a, float b, float c) bound = #0:bound;
float(float a, ...) min = #0:min;
float(float a, ...) max = #0:max;
float(float a) anglemod = #0:anglemod;
string(string s, ...) strcat = #0:strcat;
string(string s, float start, float len) substring = #0:substring;
string(string s) strtolower = #0:strtolower;
string(string fmt, ...) sprintf = #0:sprintf;
float(string s) tokenize = #0:tokenize;
float(string s) tokenize_console = #0:tokenize_console;
string(float n) argv = #0:argv;
float(float n) argv_start_index = #0:argv_start_index;
entity(entity start, .float fld, float match) findflags = #0:findflags;
entity(entity start, .string fld, string match) find = #0:find;
float(entity e) num_for_edict = #0:num_for_edict;
void(string cmd, optional string desc) registercommand = #0:registercommand;
__variant*(int size) memalloc = #0:memalloc;
void(__variant *p) memfree = #0:memfree;
filestream(string name, float mode) fopen = #0:fopen;
string(filestream f) fgets = #0:fgets;
void(filestream f) fclose = #0:fclose;
float(float mdl, string name) frameforname = #0:frameforname;
float(float mdl, float frame) frameduration = #0:frameduration;
void(optional entity e, optional vector o) touchtriggers = #0:touchtriggers;
